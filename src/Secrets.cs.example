namespace WarThunderSocialTap
{
    /// <summary>
    /// Copy this file to Secrets.cs and paste your SocialTap OAuth token.
    /// Secrets.cs is git-ignored so the token never ends up on GitHub.
    /// </summary>
    static class Secrets
    {
        // OAuth access token that was granted the "integration.status" scope.
        public const string AccessToken = "PASTE_ACCESS_TOKEN_HERE";

        // Optional. If both are filled in, the app renews the access token by itself when it expires.
        public const string RefreshToken = "";
        public const string ClientId = "";
    }
}
