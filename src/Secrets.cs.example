namespace WarThunderSocialTap
{
    /// <summary>
    /// Copy this file to Secrets.cs and fill it in.
    /// Secrets.cs is git-ignored so your details never end up on GitHub.
    /// </summary>
    static class Secrets
    {
        // Your SocialTap OAuth client. With this set, right-click the tray icon and choose
        // "Connect to SocialTap" to log in - no token needs to be pasted.
        // The client must allow the scope "integration.status" and the callback URL
        // http://127.0.0.1:8765/callback
        public const string ClientId = "";

        // Optional alternative: paste an access token (granted the "integration.status" scope)
        // here instead of using "Connect to SocialTap".
        public const string AccessToken = "PASTE_ACCESS_TOKEN_HERE";
        public const string RefreshToken = "";
    }
}
